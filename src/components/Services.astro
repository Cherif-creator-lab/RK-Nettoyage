---
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'
import { fetchSanity, hasImage, urlFor, type SanityImage } from '../lib/sanity'
import { DEFAULT_SERVICES } from '../data/defaults'

interface Service {
  title: string
  slug?: string
  shortDescription?: string
  image?: SanityImage
  icon?: string
}

interface ServiceView {
  title: string
  slug?: string
  description?: string
  icon?: string
  image: { src: string; alt: string }
}

const services = await fetchSanity<Service[]>(
  `*[_type == "service" && defined(title)] | order(order asc, title asc){
    title, "slug": slug.current, shortDescription, image, icon
  }`,
)

const items: ServiceView[] = services?.length
  ? services.map((s) => ({
      title: s.title,
      slug: s.slug,
      description: s.shortDescription,
      icon: s.icon,
      image: hasImage(s.image)
        ? { src: urlFor(s.image).width(1000).height(750).fit('crop').url(), alt: s.image.alt ?? s.title }
        : { src: '/images/produits.webp', alt: s.title },
    }))
  : DEFAULT_SERVICES.map((s) => ({
      title: s.title,
      slug: s.slug,
      description: s.shortDescription,
      icon: s.icon,
      image: s.image,
    }))
---

<section id="prestations" class="bg-white py-20 md:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow="04 // Nos prestations"
      title="Des services complets pour vos espaces"
      subtitle="Particuliers, professionnels, syndics : nous intervenons pour l’entretien courant comme pour les besoins ponctuels."
    />

    <div class="mt-14 space-y-16 md:mt-20 md:space-y-24">
      {
        items.map((service, i) => (
          <article class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
            <div class:list={[i % 2 === 1 && 'md:order-2']}>
              <img
                src={service.image.src}
                alt={service.image.alt}
                class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card"
                loading="lazy"
                decoding="async"
                width="1000"
                height="750"
              />
            </div>
            <div class:list={[i % 2 === 1 && 'md:order-1']}>
              <p class="eyebrow flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand/10 text-brand">
                  <Icon name={service.icon} class="h-4 w-4" />
                </span>
                Prestation {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-4 text-2xl leading-tight font-semibold text-brand-dark md:text-3xl">{service.title}</h3>
              {service.description && (
                <p class="mt-4 text-sm leading-relaxed text-brand-dark/65 md:text-base">{service.description}</p>
              )}
              <div class="mt-7 flex flex-wrap items-center gap-4">
                <a
                  href={service.slug ? `/contact?prestation=${service.slug}` : '/contact'}
                  class="btn btn-primary"
                >
                  Demander un devis
                </a>
                {service.slug && (
                  <a
                    href={`/prestations/${service.slug}`}
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-brand underline decoration-accent decoration-2 underline-offset-4 hover:text-brand-dark"
                  >
                    En savoir plus
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
