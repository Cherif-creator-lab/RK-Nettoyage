// Synonymes acceptés dans Sanity
const ALIASES: Record<string, string> = {
  clipboard: 'clipboard-list',
  devis: 'clipboard-list',
  creneau: 'calendar-check',
  shield: 'shield-check',
  securite: 'shield-check',
  eco: 'leaf',
  maison: 'home',
  bureau: 'building',
  equipe: 'users',
  outils: 'wrench',
  vitres: 'window',
  prix: 'euro',
  zone: 'map-pin',
}

const { name = 'sparkles', class: className = 'h-6 w-6' } = Astro.props
const key = name.trim().toLowerCase()
const paths = ICONS[key] ?? ICONS[ALIASES[key] ?? ''] ?? ICONS.sparkles
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
