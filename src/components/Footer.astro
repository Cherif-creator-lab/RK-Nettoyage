---
import type { Settings } from '../lib/sanity'

interface Props {
  settings: Settings | null
}

const { settings } = Astro.props
const siteName = settings?.siteName ?? 'RK Nettoyage Multi Services'
const year = new Date().getFullYear()
const telHref = settings?.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : null

const legalLinks = [
  { href: '/mentions-legales', label: 'Mentions légales' },
  { href: '/confidentialite', label: 'Politique de confidentialité' },
]
---

<footer id="contact" class="bg-brand-dark text-white/80">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3 md:py-16">
    <div>
      <p class="text-lg font-semibold text-white">{siteName}</p>
      {settings?.footerText && <p class="mt-3 max-w-xs text-sm leading-relaxed">{settings.footerText}</p>}
    </div>

    <div>
      <p class="font-medium text-white">Contact</p>
      <ul class="mt-4 space-y-3 text-sm">
        {
          settings?.phone && telHref && (
            <li>
              <a href={telHref} class="inline-flex items-center gap-3 hover:text-accent">
                <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
                </svg>
                {settings.phone}
              </a>
            </li>
          )
        }
        {
          settings?.email && (
            <li>
              <a href={`mailto:${settings.email}`} class="inline-flex items-center gap-3 break-all hover:text-accent">
                <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 6L2 7" />
                </svg>
                {settings.email}
              </a>
            </li>
          )
        }
        {settings?.address && <li class="whitespace-pre-line">{settings.address}</li>}
        {!settings?.phone && !settings?.email && <li class="text-white/50">Coordonnées à renseigner dans Sanity</li>}
      </ul>
    </div>

    <div>
      <p class="font-medium text-white">Informations</p>
      <ul class="mt-4 space-y-3 text-sm">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-white/50 md:flex-row md:justify-between">
      <p>© {year} {settings?.legalName ?? siteName}{settings?.legalStatus && ` — ${settings.legalStatus}`}</p>
      {settings?.siret && <p>SIRET : {settings.siret}</p>}
    </div>
  </div>
</footer>
