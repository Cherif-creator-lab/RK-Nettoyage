---
/**
 * Section « Devis et rendez-vous ».
 * Provisoire : le formulaire et le calendrier seront ajoutés à l'étape 8.
 */
import Icon from './Icon.astro'
import { fetchSanity } from '../lib/sanity'

const settings = await fetchSanity<{ phone?: string; email?: string }>(`*[_id == "settings"][0]{ phone, email }`)
const telHref = settings?.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : null
---

<section id="devis" class="bg-surface pb-20 md:pb-28">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-brand px-6 py-12 text-white md:px-14 md:py-16">
      <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-accent/15 blur-2xl" aria-hidden="true"></div>
      <div class="relative grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-center">
        <div>
          <p class="eyebrow text-white/70">06 // Devis et rendez-vous</p>
          <h2 class="mt-3 text-3xl leading-tight md:text-4xl">Demandez votre devis gratuit</h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-white/75 md:text-base">
            Décrivez votre besoin et choisissez votre créneau : nous revenons vers vous rapidement avec une proposition
            claire et sans engagement.
          </p>
        </div>

        <!-- TODO étape 8 : formulaire de devis + calendrier de rendez-vous -->
        <div class="flex flex-col gap-3">
          <a href="/contact" class="btn btn-white w-full py-4">
            Demander un devis en ligne
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          {
            telHref && (
              <a href={telHref} class="btn w-full border border-white/30 py-4 text-white hover:bg-white/10">
                <Icon name="phone" class="h-4 w-4" />
                {settings?.phone}
              </a>
            )
          }
          {
            settings?.email && (
              <a href={`mailto:${settings.email}`} class="btn w-full border border-white/30 py-4 text-white hover:bg-white/10">
                <Icon name="mail" class="h-4 w-4" />
                Écrire un e-mail
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
