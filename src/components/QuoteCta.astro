---
import Icon from './Icon.astro'
import QuoteForm from './QuoteForm'
import { getQuoteFormData } from '../lib/sanity'

const { settings, formProps } = await getQuoteFormData()
const telHref = settings?.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : null
---

<section id="devis" class="bg-surface pb-20 md:pb-28">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-brand px-6 py-12 text-white md:px-12 md:py-16">
      <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-accent/15 blur-2xl" aria-hidden="true"></div>

      <div class="relative grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div class="space-y-6">
          <div>
            <p class="eyebrow text-white/70">06 // Devis et rendez-vous</p>
            <h2 class="mt-3 text-3xl leading-tight md:text-4xl">Demandez votre devis gratuit</h2>
            <p class="mt-4 text-sm leading-relaxed text-white/75 md:text-base">
              Décrivez votre besoin et choisissez votre créneau en ligne : nous revenons vers vous rapidement avec une
              proposition claire et sans engagement.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            {
              telHref && (
                <a href={telHref} class="btn btn-white justify-start px-5 py-3.5">
                  <Icon name="phone" class="h-4 w-4 text-brand" />
                  {settings?.phone}
                </a>
              )
            }
            {
              settings?.email && (
                <a href={`mailto:${settings.email}`} class="btn justify-start border border-white/30 px-5 py-3.5 text-white hover:bg-white/10">
                  <Icon name="mail" class="h-4 w-4 text-accent" />
                  {settings.email}
                </a>
              )
            }
          </div>
        </div>

        <QuoteForm client:load {...formProps} />
      </div>
    </div>
  </div>
</section>
