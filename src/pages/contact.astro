---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { fetchSanity, type Settings } from '../lib/sanity'
import { DEFAULT_SERVICES, DEFAULT_ZONES } from '../data/defaults'

const [settings, sanityServices, sanityZones] = await Promise.all([
  fetchSanity<Settings>(`*[_id == "settings"][0]`),
  fetchSanity<{ title: string; slug: string }[]>(
    `*[_type == "service" && defined(title)] | order(order asc, title asc){ title, "slug": slug.current }`,
  ),
  fetchSanity<{ city: string; slug: string }[]>(
    `*[_type == "zone" && isActive == true && defined(city)] | order(city asc){ city, "slug": slug.current }`,
  ),
])

const services = sanityServices?.length ? sanityServices : DEFAULT_SERVICES
const zones = sanityZones?.length ? sanityZones : DEFAULT_ZONES
const telHref = settings?.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : null
---

<BaseLayout
  title="Contact et demande de devis"
  description="Demandez votre devis gratuit et choisissez votre créneau d'intervention à Lyon et ses alentours."
>
  <section class="pb-20 md:pb-28">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Devis & rendez-vous</p>
        <h1 class="mt-3 text-3xl leading-tight font-semibold text-brand-dark md:text-5xl">
          Demandez votre devis gratuit
        </h1>
        <p class="mt-4 text-base leading-relaxed text-brand-dark/70">
          Décrivez votre besoin et indiquez le créneau qui vous convient. Nous vous répondons rapidement avec une
          proposition claire et sans engagement.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-start">
        <form id="devis-form" class="card space-y-6 p-6 md:p-8" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-brand-dark">Nom complet *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Ex. : Camille Martin"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark placeholder:text-brand-dark/40 focus:border-brand focus:bg-white focus:outline-none"
              />
            </div>

            <div>
              <label for="clientType" class="block text-sm font-medium text-brand-dark">Vous êtes</label>
              <select
                id="clientType"
                name="clientType"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark focus:border-brand focus:bg-white focus:outline-none"
              >
                <option value="particulier">Particulier</option>
                <option value="entreprise">Entreprise / Commerce</option>
                <option value="copropriete">Copropriété / Syndic</option>
                <option value="agence">Agence immobilière</option>
              </select>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="phone" class="block text-sm font-medium text-brand-dark">Téléphone *</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="06 00 00 00 00"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark placeholder:text-brand-dark/40 focus:border-brand focus:bg-white focus:outline-none"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-brand-dark">E-mail *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="vous@exemple.fr"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark placeholder:text-brand-dark/40 focus:border-brand focus:bg-white focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="service" class="block text-sm font-medium text-brand-dark">Prestation souhaitée *</label>
              <select
                id="service"
                name="service"
                required
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark focus:border-brand focus:bg-white focus:outline-none"
              >
                <option value="">Choisir une prestation</option>
                {services.map((s) => <option value={s.slug ?? s.title}>{s.title}</option>)}
                <option value="autre">Autre demande / Multi-services</option>
              </select>
            </div>

            <div>
              <label for="zone" class="block text-sm font-medium text-brand-dark">Ville d'intervention *</label>
              <select
                id="zone"
                name="zone"
                required
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark focus:border-brand focus:bg-white focus:outline-none"
              >
                <option value="">Choisir une ville</option>
                {zones.map((z) => <option value={z.slug ?? z.city}>{z.city}</option>)}
                <option value="autre">Autre commune</option>
              </select>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="date" class="block text-sm font-medium text-brand-dark">Date souhaitée</label>
              <input
                id="date"
                name="date"
                type="date"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark focus:border-brand focus:bg-white focus:outline-none"
              />
            </div>

            <div>
              <label for="slot" class="block text-sm font-medium text-brand-dark">Créneau préféré</label>
              <select
                id="slot"
                name="slot"
                class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark focus:border-brand focus:bg-white focus:outline-none"
              >
                <option value="matin">Matin (8h – 12h)</option>
                <option value="apres-midi">Après-midi (13h – 18h)</option>
                <option value="flexible">Indifférent</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-brand-dark">Détails de votre besoin</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Surface approximative, fréquence souhaitée, accès, précisions utiles…"
              class="mt-2 w-full rounded-xl border border-brand/20 bg-surface/60 px-4 py-3 text-sm text-brand-dark placeholder:text-brand-dark/40 focus:border-brand focus:bg-white focus:outline-none"
            ></textarea>
          </div>

          <p id="devis-status" class="hidden rounded-xl bg-brand/10 px-4 py-3 text-sm text-brand-dark" role="status"></p>

          <button type="submit" class="btn btn-primary w-full py-4 sm:w-auto sm:px-8">
            Envoyer ma demande de devis
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </form>

        <aside class="space-y-5">
          <div class="card space-y-5">
            <h2 class="text-xl font-semibold text-brand-dark">Coordonnées directes</h2>
            <ul class="space-y-4 text-sm text-brand-dark/80">
              {
                telHref && (
                  <li>
                    <a href={telHref} class="flex items-center gap-3 hover:text-brand">
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
                        <Icon name="phone" class="h-4 w-4" />
                      </span>
                      <span>{settings?.phone}</span>
                    </a>
                  </li>
                )
              }
              {
                settings?.email && (
                  <li>
                    <a href={`mailto:${settings.email}`} class="flex items-center gap-3 break-all hover:text-brand">
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
                        <Icon name="mail" class="h-4 w-4" />
                      </span>
                      <span>{settings.email}</span>
                    </a>
                  </li>
                )
              }
              {
                settings?.address && (
                  <li class="flex items-start gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
                      <Icon name="map-pin" class="h-4 w-4" />
                    </span>
                    <span class="whitespace-pre-line">{settings.address}</span>
                  </li>
                )
              }
              {
                !telHref && !settings?.email && !settings?.address && (
                  <li class="text-brand-dark/55">Coordonnées à renseigner dans Sanity (Paramètres du site).</li>
                )
              }
            </ul>
          </div>

          <div class="rounded-2xl bg-brand p-6 text-white">
            <p class="text-sm font-medium text-accent">Réponse rapide</p>
            <p class="mt-2 text-sm leading-relaxed text-white/80">
              Intervention à Lyon, Villeurbanne, Vénissieux, Bourg-en-Bresse, Vienne, Saint-Étienne et alentours.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search)
  const preService = params.get('prestation')
  const preZone = params.get('zone')
  const serviceSelect = document.querySelector<HTMLSelectElement>('#service')
  const zoneSelect = document.querySelector<HTMLSelectElement>('#zone')
  if (preService && serviceSelect) serviceSelect.value = preService
  if (preZone && zoneSelect) zoneSelect.value = preZone

  const form = document.querySelector<HTMLFormElement>('#devis-form')
  const status = document.querySelector<HTMLElement>('#devis-status')

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }
    if (status) {
      status.textContent =
        "Votre demande est prête : l'envoi automatique et le calendrier en ligne seront connectés à l'étape 8."
      status.classList.remove('hidden')
    }
  })
</script>
