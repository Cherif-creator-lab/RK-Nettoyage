---
import BaseLayout from '../layouts/BaseLayout.astro'
import { fetchSanity, type Settings } from '../lib/sanity'

const settings = await fetchSanity<Settings>(`*[_id == "settings"][0]`)
const siteName = settings?.siteName ?? 'RK Nettoyage Multi Services'
const legalName = settings?.legalName ?? siteName
---

<BaseLayout title="Politique de confidentialité">
  <section class="pb-20 md:pb-28">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Protection des données</p>
      <h1 class="mt-3 text-3xl font-semibold text-brand-dark md:text-4xl">Politique de confidentialité</h1>

      <div class="card mt-10 space-y-8 p-6 md:p-10 text-sm leading-relaxed text-brand-dark/75">
        <div>
          <h2 class="text-xl font-semibold text-brand-dark">1. Données collectées</h2>
          <p class="mt-3">
            Lorsque vous utilisez le formulaire de demande de devis ou de prise de rendez-vous sur le site de {siteName}, nous collectons uniquement les informations nécessaires au traitement de votre demande : nom, téléphone, adresse e-mail, ville d'intervention, prestation souhaitée et détails de votre message.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-brand-dark">2. Finalité et durée de conservation</h2>
          <p class="mt-3">
            Vos données sont utilisées exclusivement par {legalName} pour établir un devis, organiser une intervention ou répondre à vos questions. Elles ne sont ni vendues ni cédées à des tiers et sont conservées pendant une durée maximale de 3 ans après le dernier échange.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-brand-dark">3. Vos droits (RGPD)</h2>
          <p class="mt-3">
            Conformément au Règlement Général sur la Protection des Données (RGPD), vous disposez d'un droit d'accès, de rectification, d'opposition et de suppression de vos données personnelles.
            {
              settings?.email
                ? ` Vous pouvez exercer ces droits à tout moment en écrivant à ${settings.email}.`
                : ' Vous pouvez exercer ces droits en nous contactant via la page Contact.'
            }
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
