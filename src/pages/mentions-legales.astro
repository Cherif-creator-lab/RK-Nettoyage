---
import BaseLayout from '../layouts/BaseLayout.astro'
import { fetchSanity, type Settings } from '../lib/sanity'

const settings = await fetchSanity<Settings>(`*[_id == "settings"][0]`)
const siteName = settings?.siteName ?? 'RK Nettoyage Multi Services'
const legalName = settings?.legalName ?? siteName
---

<BaseLayout title="Mentions légales">
  <section class="pb-20 md:pb-28">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Informations légales</p>
      <h1 class="mt-3 text-3xl font-semibold text-brand-dark md:text-4xl">Mentions légales</h1>

      <div class="card mt-10 space-y-8 p-6 md:p-10">
        <div>
          <h2 class="text-xl font-semibold text-brand-dark">1. Éditeur du site</h2>
          <dl class="mt-4 space-y-2 text-sm leading-relaxed text-brand-dark/75">
            <div><dt class="inline font-medium text-brand-dark">Raison sociale : </dt><dd class="inline">{legalName}</dd></div>
            {settings?.legalStatus && <div><dt class="inline font-medium text-brand-dark">Forme juridique : </dt><dd class="inline">{settings.legalStatus}</dd></div>}
            {settings?.siret && <div><dt class="inline font-medium text-brand-dark">SIRET : </dt><dd class="inline">{settings.siret}</dd></div>}
            {settings?.address && <div><dt class="inline font-medium text-brand-dark">Adresse : </dt><dd class="inline whitespace-pre-line">{settings.address}</dd></div>}
            {settings?.phone && <div><dt class="inline font-medium text-brand-dark">Téléphone : </dt><dd class="inline">{settings.phone}</dd></div>}
            {settings?.email && <div><dt class="inline font-medium text-brand-dark">E-mail : </dt><dd class="inline">{settings.email}</dd></div>}
            {
              settings?.publicationDirector && (
                <div>
                  <dt class="inline font-medium text-brand-dark">Directeur de la publication : </dt>
                  <dd class="inline">{settings.publicationDirector}</dd>
                </div>
              )
            }
          </dl>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-brand-dark">2. Hébergement</h2>
          <p class="mt-3 text-sm leading-relaxed text-brand-dark/75">
            Les informations relatives à l'hébergeur du site seront complétées lors de la mise en ligne définitive.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-brand-dark">3. Propriété intellectuelle</h2>
          <p class="mt-3 text-sm leading-relaxed text-brand-dark/75">
            L'ensemble des contenus présents sur ce site (textes, images, logo, graphismes) est la propriété de {legalName} ou fait l'objet d'une autorisation d'utilisation. Toute reproduction sans autorisation préalable est interdite.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
