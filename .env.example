# Sanity
PUBLIC_SANITY_PROJECT_ID=wpw94vo6
PUBLIC_SANITY_DATASET=production

# Envoi des demandes de devis par e-mail (choisir Web3Forms ou Formspree)
# Créez une clé gratuite sur https://web3forms.com avec l'e-mail du client :
PUBLIC_WEB3FORMS_KEY=
# Ou URL Formspree (ex. https://formspree.io/f/xxxxxxxx) :
PUBLIC_FORMSPREE_URL=

# Optionnel : lien vers un agenda Cal.com pour réserver en ligne
PUBLIC_CALCOM_URL=
